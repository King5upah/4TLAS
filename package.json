{
  "name": "sc-atlas",
  "version": "0.1.0",
  "description": "Interactive 2D star map for Star Citizen and any cartesian coordinate system — planets, moons, orbits, route builder",
  "author": "cargo-runners",
  "license": "MIT",
  "keywords": ["star-citizen", "star-map", "astronomy", "2d-map", "svg", "react", "celestial", "solar-system"],
  "repository": {
    "type": "git",
    "url": "https://github.com/cargo-runners/sc-atlas"
  },
  "homepage": "https://cargo-runners.github.io/sc-atlas",
  "main": "./dist/sc-atlas.umd.js",
  "module": "./dist/sc-atlas.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sc-atlas.es.js",
      "require": "./dist/sc-atlas.umd.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "cd demo && vite",
    "build": "tsc && vite build",
    "build:demo": "cd demo && vite build",
    "preview": "cd demo && vite preview",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
