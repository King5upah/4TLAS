{
  "name": "4tlas",
  "version": "0.1.0",
  "description": "Interactive 2D planetary visualization for students and astronomy enthusiasts",
  "author": "king5upah",
  "license": "MIT",
  "keywords": ["astronomy", "2d-map", "svg", "react", "celestial", "solar-system", "planetary-visualization"],
  "repository": {
    "type": "git",
    "url": "https://github.com/King5upah/4TLAS"
  },
  "homepage": "https://King5upah.github.io/4TLAS",
  "main": "./dist/sc-atlas.umd.js",
  "module": "./dist/sc-atlas.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sc-atlas.es.js",
      "require": "./dist/sc-atlas.umd.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "cd demo && vite",
    "build": "tsc && vite build",
    "build:demo": "cd demo && vite build",
    "preview": "cd demo && vite preview",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
